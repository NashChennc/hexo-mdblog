<div class="banner-container banner-container--tall">
    <div class="banner-bg" style="--banner-bg-image: url(<%- theme.banner.image || '/image/banner.png' %>);"></div>
    
    <div class="mdui-card-media-covered banner-overlay banner-overlay--tint">
        <div class="mdui-container">
            <div class="mdui-card-primary mdui-float-right mdui-text-color-white mdui-p-y-2">
                <div class="mdui-card-primary-title banner-card-title">
                    <%- partial('partial/banner-hero-titles', { variant: 'inner', role: 'title' }) %>
                </div>
                <div class="mdui-card-primary-subtitle mdui-float-right banner-card-subtitle">
                    <%- partial('partial/banner-hero-titles', { variant: 'inner', role: 'subtitle' }) %>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-shell mdui-container mdui-p-t-3 mdui-p-b-5">
    <div class="page-grid">
        <main class="page-main">
            <% page.posts.sort('title').sort('-updated').sort('-priority').each(function(post){ %>
                <%- partial('partial/postinfo', {post: post}) %>
            <% }) %>

            <% if (page.total > 1){ %>
                <div class="paginator-wrap">
                    <%- paginator({
                        prev_text: '<mdui-icon name="chevron_left"></mdui-icon>',
                        next_text: '<mdui-icon name="chevron_right"></mdui-icon>',
                        escape: false,
                        class: 'mdui-btn-group'
                    }) %>
                </div>
            <% } %>
        </main>
        <aside class="page-sidebar sticky-sidebar">
            <%- partial('partial/sidebar') %>
        </aside>
    </div>
</div>
<div id="page-bottom" aria-hidden="true"></div>
