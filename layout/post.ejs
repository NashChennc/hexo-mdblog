<!-- 全宽 Banner -->
<%- partial('partial/banner') %>
<!-- FAB -->
<%- partial('partial/fab') %>

<div class="mdui-container">
    <div class="mdui-row">
        <!-- 文章内容 -->

        <div class="mdui-col-md-9 mdui-col-xs-12 mdui-p-t-3 mdui-p-b-5">
            <div class="mdui-card mdui-hoverable">
                <div class="mdui-card-primary mdui-p-x-5">
                    <div class="mdui-card-primary-title mdui-typo-display-1">
                        <%- page.blog_title || page.title %>
                    </div>
                    <div class="mdui-row mdui-p-t-2">
                        <div class="mdui-col-xs-9 mdui-typo-caption-opacity">
                            Last Update: <%= date( page.updated, 'YYYY/MM/DD HH:mm') %>
                        </div>
                        <div class="mdui-col-xs-3">
                            <div class="mdui-float-right mdui-typo">
                                <% page.categories.each(cat=>{ %>
                                    <a href="<%- url_for(cat.path) %>">
                                        <%- cat.name %>
                                    </a>
                                <% }) %>
                            </div>
                        </div>
                    </div>
                    <div class="mdui-divider"></div>
                    <br/>
                </div>
                <div class="mdui-card-content mdui-typo mdui-p-x-5">
                    <%- page.content %>
                </div>
                <%- partial('partial/link') %>
            </div>
            
        </div>
        <!-- 侧边栏 -->
        <div class="mdui-col-md-3 mdui-col-xs-12 mdui-p-t-3 mdui-p-b-5" style="position: -webkit-sticky; position: sticky; top: 80px; z-index: 1;">
            <%- partial('partial/sidebar') %>
            <% if (page.toc !== false) { %>
                <div class="mdui-card mdui-shadow-1 mdui-m-t-2">
                    <div class="mdui-card-content">
                        <div class="mdui-typo-heading">目录</div>
                        <div class="mdui-card-content" style="max-height: 35vh; overflow-y: auto;">
                            <%- toc(page.content, {class:"mdui-list mdui-typo", list_number: false, max_depth: 3}) %>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>
<div id="bottom"></div>