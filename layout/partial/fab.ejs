<div class="site-fab-cluster" id="exampleFab">
  <mdui-dropdown placement="top-end" trigger="hover">
    <mdui-button-icon slot="trigger" icon="menu"></mdui-button-icon>
    <mdui-menu>
      <mdui-menu-item href="<%- url_for('/about') %>" icon="more_vert"><%= __('about') %></mdui-menu-item>
      <mdui-menu-item href="#top" icon="keyboard_arrow_up"><%= __('goto_top') %></mdui-menu-item>
      <mdui-menu-item href="#page-bottom" icon="keyboard_arrow_down"><%= __('goto_bottom') %></mdui-menu-item>
    </mdui-menu>
  </mdui-dropdown>
  <mdui-tooltip content="<%= __('goto_archive').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;') %>" placement="left">
    <mdui-fab icon="bookmark" href="<%- url_for('/archives') %>" variant="primary"></mdui-fab>
  </mdui-tooltip>
</div>
