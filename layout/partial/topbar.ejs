<mdui-top-app-bar class="app-top-bar">
  <% if (site.categories.length) { %>
    <div class="topbar-spacer" aria-hidden="true"></div>
    <nav class="topbar-nav">
      <a href="<%- url_for('/') %>" class="topbar-nav__link<%= is_home() ? ' topbar-nav__link--active' : '' %>"<% if (is_home()) { %> aria-current="page"<% } %>><%= __('home') %></a>
      <% site.categories.sort('length').sort('-name').each(item => { %>
        <% if (item.posts.length) { %>
          <a href="<%- url_for('categories/' + item.name) %>" class="topbar-nav__link<%= is_category() && page.category === item.name ? ' topbar-nav__link--active' : '' %>"<% if (is_category() && page.category === item.name) { %> aria-current="page"<% } %>><%= item.name %> | <%= item.posts.length %></a>
        <% } %>
      <% }); %>
    </nav>
    <div class="topbar-spacer" aria-hidden="true"></div>
  <% } else { %>
    <mdui-top-app-bar-title><%= config.title %></mdui-top-app-bar-title>
    <div class="topbar-spacer" aria-hidden="true"></div>
  <% } %>
  <a href="<%- url_for('/about') %>" class="topbar-about-link"<% if (typeof page !== 'undefined' && page.path && /^about(\/|$)/.test(page.path)) { %> aria-current="page"<% } %>><%= __('about') %></a>
</mdui-top-app-bar>
