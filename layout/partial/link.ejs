<%
                    var prevPost = null;
                    var nextPost = null;
                    var currentCatName = "";
                    
                    if (page.categories && page.categories.length){
                        var cat = page.categories.data[0];
                        currentCatName = cat.name;
                        
                        var posts = cat.posts.sort('title').sort('-updated').sort('-priority');
                        
                        var currentIndex = -1;
                        posts.forEach(function(p, i){
                            if (p._id == page._id) currentIndex = i;
                        });

                        if (currentIndex > 0) {
                            nextPost = posts.data[currentIndex - 1];
                        }
                        if (currentIndex < posts.length - 1) {
                            prevPost = posts.data[currentIndex + 1];
                        }
                    }
                %>

                <% if (prevPost || nextPost) { %>
                <mdui-divider></mdui-divider>
                <div class="post-nav">
                    <div class="post-nav__side post-nav__side--prev">
                            <% if(prevPost){ %>
                                <a href="<%- url_for(prevPost.path) %>" class="post-nav__link">
                                    <div class="post-nav__label">
                                        <mdui-icon name="arrow_back"></mdui-icon>
                                        <%= __('prev_post') %>
                                    </div>
                                    <div class="post-nav__title">
                                        <%= currentCatName %> | <%= prevPost.title %>
                                    </div>
                                </a>
                            <% } %>
                    </div>
                    <div class="post-nav__side post-nav__side--next">
                            <% if(nextPost){ %>
                                <a href="<%- url_for(nextPost.path) %>" class="post-nav__link">
                                    <div class="post-nav__label">
                                        <%= __('next_post') %>
                                        <mdui-icon name="arrow_forward"></mdui-icon>
                                    </div>
                                    <div class="post-nav__title">
                                        <%= currentCatName %> | <%= nextPost.title %>
                                    </div>
                                </a>
                            <% } %>
                    </div>
                </div>
                <% } %>
