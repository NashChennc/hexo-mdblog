<%
                    var prevPost = null;
                    var nextPost = null;
                    var currentCatName = "";
                    
                    if (page.categories && page.categories.length){
                        var cat = page.categories.data[0];
                        currentCatName = cat.name; // 获取类别名
                        
                        var posts = cat.posts.sort('title').sort('-updated').sort('-priority');
                        
                        // 查找当前位置
                        var currentIndex = -1;
                        posts.forEach(function(p, i){
                            if (p._id == page._id) currentIndex = i;
                        });

                        // 确定上一篇和下一篇
                        if (currentIndex > 0) {
                            nextPost = posts.data[currentIndex - 1];
                        }
                        if (currentIndex < posts.length - 1) {
                            prevPost = posts.data[currentIndex + 1];
                        }
                    }
                %>

                <% if (prevPost || nextPost) { %>
                <div class="mdui-divider"></div>
                <div class="mdui-card-actions mdui-p-x-3 mdui-p-y-2">
                    <div class="mdui-row">
                        <div class="mdui-col-sm-3 mdui-text-left">
                            <% if(prevPost){ %>
                                <a href="<%- url_for(prevPost.path) %>" class="mdui-ripple mdui-hoverable mdui-p-a-1 mdui-text-truncate" style="display: block; text-decoration: none;">
                                    <div class="mdui-typo-caption mdui-text-color-theme-accent mdui-text-truncate">
                                        <i class="mdui-icon material-icons" style="font-size: 14px; vertical-align: middle;">arrow_back</i> 
                                        <%= __('prev_post') %>
                                    </div>
                                    <div class="mdui-typo-body-1 mdui-m-t-1 mdui-text-truncate mdui-text-color-black" style="font-weight: 500;">
                                        <%= currentCatName %> | <%= prevPost.title %>
                                    </div>
                                </a>
                            <% } %>
                        </div>
                        <div class="mdui-col-sm-6"></div>
                        <div class="mdui-col-sm-3 mdui-text-right">
                            <% if(nextPost){ %>
                                <a href="<%- url_for(nextPost.path) %>" class="mdui-ripple mdui-hoverable mdui-p-a-1 mdui-text-truncate" style="display: block; text-decoration: none;">
                                    <div class="mdui-typo-caption mdui-text-color-theme-accent mdui-text-truncate">
                                        <%= __('next_post') %>
                                        <i class="mdui-icon material-icons" style="font-size: 14px; vertical-align: middle;">arrow_forward</i>
                                    </div>
                                    <div class="mdui-typo-body-1 mdui-m-t-1 mdui-text-truncate mdui-text-color-black" style="font-weight: 500;">
                                        <%= currentCatName %> | <%= nextPost.title %>
                                    </div>
                                </a>
                            <% } %>
                        </div>
                    </div>
                </div>
                <% } %>
                