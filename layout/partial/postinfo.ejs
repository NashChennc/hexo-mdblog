<mdui-card variant="elevated" class="postinfo-card">
  <div class="postinfo-card__title-row">
    <a href="<%= url_for(post.path) %>" class="postinfo-card__title-link">
      <%= post.blog_title || post.title %>
    </a>
    <mdui-chip variant="assist" icon="checklist" disabled class="postinfo-card__progress-chip">
      <%= post.rate ? post.rate : "0" %>% <%= __('completed') %>
    </mdui-chip>
  </div>
  <div class="postinfo-card__meta">
    <span class="postinfo-card__meta-item">
      <mdui-icon name="calendar_today" class="postinfo-card__meta-icon"></mdui-icon>
      <%= date(post.updated, 'Y年M月D日 ddd') %>
    </span>
    <span class="postinfo-card__meta-item">
      <mdui-icon name="category" class="postinfo-card__meta-icon"></mdui-icon>
      <% var _cats = []; post.categories.each(function (cat) { _cats.push(cat.name); }); %><%= _cats.join('，') %>
    </span>
  </div>
  <div class="postinfo-card__stats">
    <%= __('word_count') %>：<%= wordcount(post.content) %> |
    <%= __('reading_time') %>：<%= min2read(post.content, { cn: 200, en: 500 }) %> min
  </div>
</mdui-card>
