<mdui-card variant="elevated" class="postinfo-card">
    <div class="postinfo-card__title-row">
        <a href="<%=url_for(post.path)%>">
            <%= post.blog_title || post.title %>
        </a>
        <div class="postinfo-card__rate">
            <span><%= post.rate ? post.rate : "0" %>%</span>
            <span class="postinfo-card__rate-label"><%= __('completed') %></span>
        </div>
    </div>
    <div class="postinfo-card__meta">
        <span><%= date( post.updated, 'Y年M月D日 ddd') %></span>
        <span><% var _cats = []; post.categories.each(function(cat){ _cats.push(cat.name); }); %><%= _cats.join('，') %></span>
    </div>
    <mdui-divider></mdui-divider>
    <div class="postinfo-card__stats">
        <%= __('word_count') %>：<%= wordcount(post.content) %> &nbsp; <%= __('reading_time') %>：<%= min2read(post.content, {cn: 200, en: 500}) %> min
    </div>
</mdui-card>
