  <div class="mdui-divider"></div> -->

  <div class="mdui-divider"></div>

  <div class="mdui-list mdui-list-dense mdui-p-y-0">
    <% if (theme.social) { %>
        <% for (var i in theme.social) { %>
            <a href="<%- url_for(theme.social[i].link) %>" target="_blank" class="mdui-list-item mdui-ripple sidebar-social-link">
                <i class="mdui-list-item-icon <%- theme.social[i].icon %> <%- theme.social[i].color %> sidebar-social-icon"></i>
                <div class="mdui-list-item-content mdui-text-truncate sidebar-social-text">
                    <%- theme.social[i].text || theme.social[i].link %>
                </div>
            </a>
        <% } %>
    <% } %>
  </div>
  </div>
