<div class="mdui-card mdui-shadow-1">
  <div class="mdui-card-media sidebar-card-media">
    <img src="<%- theme.sidebar_config.image || theme.banner.image %>" class="mdui-img-fluid sidebar-card-media__img" alt="">
  </div>

  <div class="mdui-card-content mdui-text-center sidebar-card-content--main">
    <% if (theme.sidebar_config.avatar || theme.avatar) { %>
      <img src="<%- theme.sidebar_config.avatar || theme.avatar %>" class="mdui-img-circle mdui-shadow-4 sidebar-avatar-offset sidebar-avatar" alt="">
    <% } else { %>
      <div class="mdui-img-circle mdui-shadow-4 mdui-color-white sidebar-avatar-offset mdui-flex mdui-flex-center mdui-flex-middle sidebar-avatar sidebar-avatar--placeholder">
         <i class="material-icons mdui-text-color-theme sidebar-avatar__icon">person</i>
      </div>
    <% } %>

    <div class="mdui-typo-headline mdui-m-t-2"><%= config.author %></div>
    <div class="mdui-typo-caption mdui-text-color-grey-600 mdui-m-t-1">
      <%= theme.sidebar_config.description || config.description || __('welcome') %>
    </div>
  </div>

