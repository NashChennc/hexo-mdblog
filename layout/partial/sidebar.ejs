  <div class="mdui-divider"></div> -->

  <div class="mdui-divider"></div>

  <div class="mdui-list mdui-list-dense mdui-p-y-0">
    <% if (theme.social) { %>
        <% for (var i in theme.social) { %>
            <a href="<%- url_for(theme.social[i].link) %>" target="_blank" class="mdui-list-item mdui-ripple" style="min-height: 40px; height: 40px;">
                <i class="mdui-list-item-icon <%- theme.social[i].icon %> <%- theme.social[i].color %>" style="font-size: 18px; width: 20px; text-align: center;"></i>
                <div class="mdui-list-item-content mdui-text-truncate" style="font-size: 12.5px; opacity: 0.8; margin-left: 12px;">
                    <%- theme.social[i].text || theme.social[i].link %>
                </div>
            </a>
        <% } %>
    <% } %>
  </div>
  </div>