<table class="mdui-table mdui-hoverable">
    <thead class=" mdui-hoverable">
        <tr>
            <td> Last Update </td>
            <td> Title </td>
            <td> Category </td>
            <td> Completion Rate </td>
        </tr>
    </thead>
    <tbody>
        <% site.posts.sort('updated',-1).each(post=>{ %>
            <% if(post.categories.length) { %>
            <tr class=" mdui-hoverable">
                <td>
                    <%= date( post.updated, 'MM/DD') %>
                </td>
                <td>
                    <div class="mdui-typo"><a href=" <%=url_for(post.path)%>">
                        <%= post.blog_title %>
                    </a></div>
                </td>
                <td>
                    <% post.categories.each(cat=>{ %>
                        <%= cat.name %>
                    <% }) %>
                </td>
                <td>
                    <%=  post.rate ? post.rate :"0" %> %
                </td>
            </tr>
            <% } %>
        <% })%>
    </tbody>
</table>