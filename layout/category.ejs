<!-- 全宽 Banner -->
<!-- <%- partial('partial/banner') %> -->

<div class="page-shell mdui-container mdui-p-t-3 mdui-p-b-5">
    <div class="page-grid page-grid--single">
        <main class="page-main">
            <div class="category-page-centered">
                <% page.posts.sort('title').sort('-updated').sort('-priority').each(function(post){ %>
                    <%- partial("partial/postinfo", {post: post}) %>
                <% })%>
                <% if (page.total > 1){ %>
                    <%- partial('partial/paginator') %>
                <% } %>
            </div>
        </main>
    </div>
</div>
<div id="page-bottom" aria-hidden="true"></div>
