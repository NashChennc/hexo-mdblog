<style>
    /* * 局部样式优化 
     * 仅作用于首页，增强视觉体验
     */
    
    /* 封面容器：更加大气的展示 */
    .hero-banner {
        position: relative;
        width: 100%;
        height: 95vh; /* 占满全屏 */
        min-height: 400px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .hero-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-position: center center;
        background-size: cover;
        z-index: 0;
        transition: transform 0.3s ease-out; /* 简单的视差基底 */
    }

    /* 遮罩层，保证文字可读性 */
    .hero-mask {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(to bottom, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.6) 100%);
        z-index: 1;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        text-align: center;
        color: #fff;
        padding: 20px;
        opacity: 0;
        animation: heroFadeIn 1s cubic-bezier(0.215, 0.61, 0.355, 1) forwards;
        animation-delay: 0.3s;
    }

    /* 标题动画 */
    @keyframes heroFadeIn {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* 向下滚动指示器 */
    .scroll-down-btn {
        position: absolute;
        bottom: 40px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 5;
        color: rgba(255,255,255,0.8);
        animation: bounce 2s infinite;
        cursor: pointer;
    }

    @keyframes bounce {
        0%, 20%, 50%, 80%, 100% {transform: translateX(-50%) translateY(0);}
        40% {transform: translateX(-50%) translateY(-10px);}
        60% {transform: translateX(-50%) translateY(-5px);}
    }

    /* 文章卡片增强 */
    .post-card {
        height: 100%; /* 撑满父容器高度 */
        display: flex;
        flex-direction: column;
        border-radius: 8px !important;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        background: #fff;
    }

    .post-card:hover {
        transform: translateY(-6px); /* 稍微减小悬浮幅度 */
        box-shadow: 0 8px 16px -8px rgba(0,0,0,0.2) !important;
    }
    
    .post-card-media {
        height: 160px; /* 缩小一点高度，原200px */
        overflow: hidden;
        background-color: #f5f5f5;
        position: relative;
    }

    .post-card-content {
        flex-grow: 1;
        padding: 16px 20px; /* 稍微减小内边距 */
        display: flex;
        flex-direction: column;
    }

    /* 限制摘要行数，保证高度统一 */
    .limit-lines {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3; /* 限制显示3行 */
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.6;
        height: calc(1.6em * 3); /* 固定高度占位 */
        font-size: 14px; /* 字体稍微改小一点点 */
    }

    /* 滚动出现动画类 */
    .scroll-reveal {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }
    
    .scroll-reveal.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    /* 标签 Chips 样式微调 */
    .tag-chip {
        font-size: 11px; /* 缩小标签字体 */
        height: 20px;
        line-height: 20px;
        margin-right: 4px;
        background-color: rgba(0,0,0,0.05);
        color: #757575;
    }

    /* 首篇文章特别样式 */
    .featured-post .post-card-media {
        height: 350px; /* 首图保持大气 */
    }
    
    /* 强制等高列：Flexbox 布局补丁 */
    .equal-height-row {
        display: flex;
        flex-wrap: wrap;
    }
    .equal-height-col {
        display: flex;
        flex-direction: column;
    }
</style>

<!-- 1. Hero Banner 区域 -->
<div class="hero-banner">
    <%
        // 获取本地 banner 目录下的所有文件名列表
        var bannerList = get_banner_list();
        var defaultBg = "";
        
        // 如果有图片，随机选一张作为首页全屏背景
        if (bannerList && bannerList.length > 0) {
            var randomIndex = Math.floor(Math.random() * bannerList.length);
            defaultBg = url_for('image/banner/' + bannerList[randomIndex]);
        } else {
            // 兜底图片 (如果文件夹为空)
            defaultBg = theme.banner.image
        }
    %>
    <div class="hero-bg" style="background-image: url(<%- theme.banner.image || config.head_bgpaper || defaultBg %>);"></div>
    <div class="hero-mask"></div>
    
    <div class="hero-content">
        <div class="mdui-typo-display-3" style="font-weight: 300; letter-spacing: 2px;">
            <%= theme.banner.title || config.title %>
        </div>
        <div class="mdui-typo-headline mdui-m-t-2" style="font-weight: 300; opacity: 0.9;">
            <%= theme.banner.subtitle || config.subtitle %>
        </div>
    </div>

    <div class="scroll-down-btn" onclick="document.getElementById('main-content-anchor').scrollIntoView({behavior: 'smooth'})">
        <i class="mdui-icon material-icons" style="font-size: 36px;">keyboard_arrow_down</i>
    </div>
</div>

<div id="main-content-anchor"></div>

<!-- 2. 主要内容区域 -->
<div class="mdui-container mdui-p-t-4 mdui-p-b-5">
    <div class="mdui-row">
        <!-- 左侧文章列表 -->
        <div class="mdui-col-md-9 mdui-col-xs-12">
            
            <div class="mdui-row equal-height-row">
                <% 
                    // 简单的 Hash 函数，用于根据标题生成固定的数字
                    var getHash = function(str) {
                        var hash = 0;
                        if (str.length === 0) return hash;
                        for (var i = 0; i < str.length; i++) {
                            hash = (hash << 5) - hash + str.charCodeAt(i);
                            hash |= 0; 
                        }
                        return Math.abs(hash);
                    };
                %>
                
                <% page.posts.sort('title').sort('-updated').sort('-priority').each(function(post, i){ %>
                    <!-- 
                        布局逻辑：
                        第一页的第一篇：Full Width (12 cols)
                        其他：3 cols (md-4) -> 这样卡片会变小
                    -->
                    <% var isFeatured = (i === 0 && page.current === 1); %>
                    
                    <% 
                        // 图片逻辑：优先 Banner > Photos > 文章内图片 > 本地随机图
                        var coverUrl = null;

                        // 尝试从文章内容提取第一张图片
                        var contentImg = null;
                        var imgRegex = /<img[^>]+src="([^">]+)"/i;
                        var imgMatch = post.content.match(imgRegex);
                        if (imgMatch && imgMatch[1]) {
                            contentImg = imgMatch[1];
                        }

                        if (post.banner) {
                            coverUrl = post.banner;
                        } else if (post.photos && post.photos.length) {
                            coverUrl = post.photos[0];
                        } else if (contentImg) {
                             coverUrl = contentImg;
                        } else {
                            var localBanners = get_banner_list();
                            
                            if (localBanners && localBanners.length > 0) {
                                var seed = getHash(post.title);
                                var index = seed % localBanners.length;
                                coverUrl = url_for('image/banner/' + localBanners[index]);
                            } else {
                                // 最后的兜底
                                coverUrl = ""; 
                            }
                        }
                    %>
                    
                    <div class="mdui-col-xs-12 <%= isFeatured ? 'mdui-col-md-12 featured-post' : 'mdui-col-sm-6 mdui-col-md-4 equal-height-col' %> mdui-m-b-4 scroll-reveal">
                        
                        <article class="mdui-card mdui-shadow-2 post-card">
                            
                            <!-- 卡片头部：图片 -->
                            <a href="<%- url_for(post.path) %>" class="post-card-media mdui-ripple">
                                <% if (coverUrl) { %>
                                    <img src="<%= coverUrl %>" style="width: 100%; height: 100%; object-fit: cover;">
                                <% } else { %>
                                    <!-- 确实没有任何图片时的 fallback -->
                                    <div style="width: 100%; height: 100%; background: #eee; display: flex; align-items: center; justify-content: center;">
                                        <i class="mdui-icon material-icons mdui-text-color-grey-400">image</i>
                                    </div>
                                <% } %>
                                
                                <!-- 覆盖层标题 (仅在特色文章显示) -->
                                <% if (isFeatured) { %>
                                    <div class="mdui-card-media-covered mdui-card-media-covered-gradient">
                                        <div class="mdui-card-primary">
                                            <div class="mdui-card-primary-title"><%= post.title %></div>
                                            <div class="mdui-card-primary-subtitle"><%= date(post.updated, 'YYYY-MM-DD') %></div>
                                        </div>
                                    </div>
                                <% } %>
                            </a>

                            <!-- 卡片内容 -->
                            <div class="post-card-content">
                                <!-- 分类标签 -->
                                <div class="mdui-m-b-1">
                                    <% if (post.categories && post.categories.length) { %>
                                        <% post.categories.each(function(cat){ %>
                                            <a href="<%- url_for(cat.path) %>" class="mdui-chip mdui-ripple mdui-text-color-theme">
                                                <span class="mdui-chip-title"><%= cat.name %></span>
                                            </a>
                                        <% }) %>
                                    <% } else { %>
                                        <span class="mdui-chip"><span class="mdui-chip-title">未分类</span></span>
                                    <% } %>
                                </div>

                                <!-- 标题 (非 Featured 时显示) -->
                                <% if (!isFeatured) { %>
                                    <a href="<%- url_for(post.path) %>" class="mdui-text-color-theme-text" style="text-decoration: none;">
                                        <div class="mdui-typo-headline mdui-m-b-1" style="font-size: 18px; line-height: 1.4; font-weight: 500;">
                                            <%= post.title %>
                                        </div>
                                    </a>
                                    <div class="mdui-typo-caption-opacity mdui-m-b-2">
                                        <%= date(post.updated, 'YYYY-MM-DD') %>
                                    </div>
                                <% } %>

                                <!-- 摘要 -->
                                <div class="mdui-typo-body-1 mdui-text-color-grey-700 mdui-m-b-2 limit-lines" style="flex-grow: 1;">
                                    <% if(post.excerpt) { %>
                                        <%- post.excerpt %>
                                    <% } else { %>
                                        <%= strip_html(post.content).substring(0, 100) %>...
                                    <% } %>
                                </div>
                                
                                <div class="mdui-divider mdui-m-y-1"></div>

                                <!-- 底部操作 -->
                                <div class="mdui-row-xs-2">
                                    <div class="mdui-col mdui-text-left mdui-typo-caption-opacity" style="line-height: 36px; font-size: 12px;">
                                        <%= min2read(post.content, {cn: 200, en: 500}) %> min read
                                    </div>
                                    <div class="mdui-col mdui-text-right">
                                        <a href="<%- url_for(post.path) %>" class="mdui-btn mdui-btn-icon mdui-text-color-theme mdui-ripple" mdui-tooltip="{content: 'Read full article'}">
                                            <i class="mdui-icon material-icons">arrow_forward</i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </article>
                    </div>
                <% }) %>
            </div>

            <!-- 分页器 -->
            <% if (page.total > 1){ %>
                <div class="mdui-text-center mdui-m-t-4 scroll-reveal">
                    <%- paginator({
                        prev_text: '<i class="mdui-icon material-icons">chevron_left</i>',
                        next_text: '<i class="mdui-icon material-icons">chevron_right</i>',
                        escape: false,
                        class: 'mdui-btn-group'
                    }) %>
                </div>
            <% } %>
        </div>

        <!-- 侧边栏：保持在右侧但增加粘性效果 -->
        <div class="mdui-col-md-3 mdui-col-xs-12"  style="position: -webkit-sticky; position: sticky; top: 80px; z-index: 1;">
            <%- partial('partial/sidebar') %>
        </div>
    </div>
</div>
<div id="bottom"></div>

<!-- 3. 简单的滚动显现脚本 -->
<script>
document.addEventListener("DOMContentLoaded", function() {
    // 简单的 Intersection Observer 实现卡片滚动淡入
    const observerOptions = {
        root: null,
        rootMargin: '0px',
        threshold: 0.1
    };

    const observer = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry, index) => {
            if (entry.isIntersecting) {
                // 添加延迟，制造交错感 (Stagger effect)
                setTimeout(() => {
                    entry.target.classList.add('is-visible');
                }, index * 100); // 每个元素延迟 100ms
                observer.unobserve(entry.target);
            }
        });
    }, observerOptions);

    const elements = document.querySelectorAll('.scroll-reveal');
    elements.forEach(el => observer.observe(el));
});
</script>