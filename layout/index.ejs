
<!-- 1. Hero Banner 区域 -->
<div class="hero-banner">
    <%
        // 获取本地 banner 目录下的所有文件名列表
        var bannerImageList = get_banner_list();
        var fallbackImage = "";
        
        // 如果有图片，随机选一张作为首页全屏背景
        if (bannerImageList && bannerImageList.length > 0) {
            var randomIndex = Math.floor(Math.random() * bannerImageList.length);
            fallbackImage = url_for('image/banner/' + bannerImageList[randomIndex]);
        } else {
            // 兜底图片 (如果文件夹为空)
            fallbackImage = theme.banner.image
        }
    %>
    <div class="hero-bg" style="background-image: url(<%- theme.banner.image || config.head_bgpaper || fallbackImage %>);"></div>
    <div class="hero-mask"></div>
    
    <div class="hero-content mdui-text-center mdui-text-color-white mdui-p-b-4">
        <div class="mdui-typo-display-3" style="font-weight: 300; letter-spacing: 2px;">
            <%- theme.banner.index_title || theme.banner.title || config.title || __('default_site_title') %>
        </div>
        <div class="mdui-typo-headline mdui-m-t-2" style="font-weight: 300; opacity: 0.9;">
            <%- theme.banner.index_subtitle || theme.banner.subtitle || config.subtitle || __('default_site_subtitle') %>
        </div>
    </div>
</div>

<!-- 2. 主要内容区域 -->
<div class="mdui-container mdui-p-t-4 mdui-p-b-5">
    <div class="mdui-row">
        <!-- 左侧文章列表 -->
        <div class="mdui-col-md-9 mdui-col-xs-12">
            
            <div class="mdui-row equal-height-row">
                <% 
                    // 根据字符串生成固定哈希值的函数，用于为文章选择对应的 banner 图片
                    var generateHashFromString = function(str) {
                        var hash = 0;
                        if (str.length === 0) return hash;
                        for (var i = 0; i < str.length; i++) {
                            hash = (hash << 5) - hash + str.charCodeAt(i);
                            hash |= 0; 
                        }
                        return Math.abs(hash);
                    };
                %>
                
                <% page.posts.sort('title').sort('-updated').sort('-priority').each(function(post, i){ %>
                    <!-- 
                        布局逻辑：
                        第一页的第一篇：Full Width (12 cols)
                        其他：3 cols (md-4) -> 这样卡片会变小
                    -->
                    <% var isFeatured = (i === 0 && page.current === 1); %>
                    
                    <% 
                        // 封面图片选择逻辑：优先 Banner > Photos > 文章内图片 > 本地随机图
                        var coverImageUrl = null;

                        // 尝试从文章内容提取第一张图片
                        var firstImageFromContent = null;
                        var imageRegex = /<img[^>]+src="([^">]+)"/i;
                        var imageMatch = post.content.match(imageRegex);
                        if (imageMatch && imageMatch[1]) {
                            firstImageFromContent = imageMatch[1];
                        }

                        if (post.banner) {
                            coverImageUrl = post.banner;
                        } else if (post.photos && post.photos.length) {
                            coverImageUrl = post.photos[0];
                        } else if (firstImageFromContent) {
                             coverImageUrl = firstImageFromContent;
                        } else {
                            var localBannerImages = get_banner_list();
                            
                            if (localBannerImages && localBannerImages.length > 0) {
                                var hashSeed = generateHashFromString(post.title);
                                var bannerIndex = hashSeed % localBannerImages.length;
                                coverImageUrl = url_for('image/banner/' + localBannerImages[bannerIndex]);
                            } else {
                                // 最后的兜底
                                coverImageUrl = ""; 
                            }
                        }
                    %>
                    
                    <div class="mdui-col-xs-12 <%= isFeatured ? 'mdui-col-md-12 featured-post' : 'mdui-col-sm-6 mdui-col-md-4 equal-height-col' %> mdui-m-b-4 scroll-reveal">
                        
                        <article class="mdui-card mdui-shadow-2 post-card">
                            
                            <!-- 卡片头部：图片 -->
                            <a href="<%- url_for(post.path) %>" class="post-card-media mdui-ripple mdui-color-grey-100">
                                <% if (coverImageUrl) { %>
                                    <img src="<%= coverImageUrl %>" class="mdui-img-fluid" style="width: 100%; height: 100%; object-fit: cover;">
                                <% } else { %>
                                    <!-- 确实没有任何图片时的 fallback -->
                                    <div class="mdui-flex mdui-flex-center mdui-flex-middle" style="width: 100%; height: 100%;">
                                        <i class="mdui-icon material-icons mdui-text-color-grey-400">image</i>
                                    </div>
                                <% } %>
                                
                                <!-- 覆盖层标题 (仅在特色文章显示) -->
                                <% if (isFeatured) { %>
                                    <div class="mdui-card-media-covered mdui-card-media-covered-gradient">
                                        <div class="mdui-card-primary">
                                            <div class="mdui-card-primary-title"><%= post.title %></div>
                                            <div class="mdui-card-primary-subtitle"><%= date(post.updated, 'YYYY-MM-DD') %></div>
                                        </div>
                                    </div>
                                <% } %>
                            </a>

                            <!-- 卡片内容 -->
                            <div class="post-card-content mdui-p-x-5 mdui-p-y-4">
                                <!-- 分类标签 -->
                                <div class="mdui-m-b-1">
                                    <% if (post.categories && post.categories.length) { %>
                                        <% post.categories.each(function(cat){ %>
                                            <a href="<%- url_for(cat.path) %>" class="mdui-chip mdui-ripple mdui-text-color-theme">
                                                <span class="mdui-chip-title"><%= cat.name %></span>
                                            </a>
                                        <% }) %>
                                    <% } else { %>
                                        <span class="mdui-chip"><span class="mdui-chip-title"><%= __('uncategorized') %></span></span>
                                    <% } %>
                                </div>

                                <!-- 标题 (非 Featured 时显示) -->
                                <% if (!isFeatured) { %>
                                    <a href="<%- url_for(post.path) %>" class="mdui-text-color-theme-text" style="text-decoration: none;">
                                        <div class="mdui-typo-subheading mdui-m-b-1" style="font-weight: 500;">
                                            <%= post.title %>
                                        </div>
                                    </a>
                                    <div class="mdui-typo-caption-opacity mdui-m-b-2">
                                        <%= date(post.updated, 'YYYY-MM-DD') %>
                                    </div>
                                <% } %>

                                <!-- 摘要 -->
                                <div class="mdui-typo-body-1 mdui-text-color-grey-700 mdui-m-b-2 limit-lines" style="flex-grow: 1;">
                                    <% if(post.excerpt) { %>
                                        <%- post.excerpt %>
                                    <% } else { %>
                                        <%= strip_html(post.content).substring(0, 100) %>...
                                    <% } %>
                                </div>
                                
                                <div class="mdui-divider mdui-m-y-1"></div>

                                <!-- 底部操作 -->
                                <div class="mdui-row-xs-2">
                                    <div class="mdui-col mdui-text-left mdui-typo-caption-opacity">
                                        <%= min2read(post.content, {cn: 200, en: 500}) %> <%= __('min_read') %>
                                    </div>
                                    <div class="mdui-col mdui-text-right">
                                        <a href="<%- url_for(post.path) %>" class="mdui-btn mdui-btn-icon mdui-text-color-theme mdui-ripple" mdui-tooltip="{content: '<%= __('read_full_article') %>'}">
                                            <i class="mdui-icon material-icons">arrow_forward</i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </article>
                    </div>
                <% }) %>
            </div>

            <!-- 分页器 -->
            <% if (page.total > 1){ %>
                <div class="mdui-text-center mdui-m-t-4 scroll-reveal">
                    <%- paginator({
                        prev_text: '<i class="mdui-icon material-icons">chevron_left</i>',
                        next_text: '<i class="mdui-icon material-icons">chevron_right</i>',
                        escape: false,
                        class: 'mdui-btn-group'
                    }) %>
                </div>
            <% } %>
        </div>

        <!-- 侧边栏：保持在右侧但增加粘性效果 -->
        <div class="mdui-col-md-3 mdui-col-xs-12 sticky-sidebar">
            <%- partial('partial/sidebar') %>
        </div>
    </div>
</div>
<div id="page-bottom" aria-hidden="true"></div>

<!-- 3. 简单的滚动显现脚本 -->
<script>
document.addEventListener("DOMContentLoaded", function() {
    // 简单的 Intersection Observer 实现卡片滚动淡入
    const observerOptions = {
        root: null,
        rootMargin: '0px',
        threshold: 0.1
    };

    const observer = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry, index) => {
            if (entry.isIntersecting) {
                // 添加延迟，制造交错感 (Stagger effect)
                setTimeout(() => {
                    entry.target.classList.add('is-visible');
                }, index * 100); // 每个元素延迟 100ms
                observer.unobserve(entry.target);
            }
        });
    }, observerOptions);

    const elements = document.querySelectorAll('.scroll-reveal');
    elements.forEach(el => observer.observe(el));
});
</script>